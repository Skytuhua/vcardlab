{
  "name": "vcardlab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Privacy-first, 100% in-browser vCard (.vcf) contacts workbench: view, edit, de-duplicate, merge, split, clean and convert your address book to vCard, CSV or JSON. Nothing is uploaded.",
  "license": "MIT",
  "author": "Skytuhua",
  "homepage": "https://skytuhua.github.io/vcardlab/",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "GITHUB_PAGES=1 tsc -b && GITHUB_PAGES=1 vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "deploy": "npm run build:pages && gh-pages -d dist"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@tanstack/react-virtual": "^3.13.26",
    "fflate": "^0.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^3.2.4"
  }
}
